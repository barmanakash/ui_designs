# ─────────────────────────────────────────────────────────────
# Frameflow environment variables. Copy to .env (local) and set the
# same names in Vercel → Project → Settings → Environment Variables.
# Variables starting with VITE_ are PUBLIC (shipped to the browser).
# Everything else is SERVER-ONLY and must never be prefixed with VITE_.
# The app runs in DEMO MODE (mock data, no login) if Supabase keys are missing.
# ─────────────────────────────────────────────────────────────

# ── Supabase (public) ────────────────────────────────────────
# Project URL: Supabase → Project Settings → API
VITE_SUPABASE_URL=
# The anon / publishable key (safe for the browser; protected by RLS)
VITE_SUPABASE_ANON_KEY=

# ── Supabase (server-only) ───────────────────────────────────
# Same project URL, used by /api functions and scripts
SUPABASE_URL=
# service_role key. BYPASSES RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────
# Public site URL (no trailing slash). Used for sitemap and canonical/OG URLs.
VITE_SITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# ── Anthropic (server-only) — powers /api/find-references ────
ANTHROPIC_API_KEY=
# Model used for Find References
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Payments ─────────────────────────────────────────────────
# razorpay (default) or stripe (adapter stub, not implemented)
VITE_PAYMENT_PROVIDER=razorpay
# Razorpay Key Id (public, used by Checkout in the browser)
VITE_RAZORPAY_KEY_ID=
# Razorpay Key Id + Secret (server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Plan ids; create them with `npm run razorpay:plans` or in the dashboard
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# Prices are no longer set here. Edit PRICING in src/lib/constants.ts (₹499/month, ₹3,999/year).
# The Razorpay plans above must match those amounts.

# ── Email (Resend, server-only) ──────────────────────────────────────────────────
# Used for: welcome, receipts, payment failed, cancellation, submission approved/rejected,
# newsletter confirmation and takedown-report alerts. If these are blank, emails are skipped
# (logged, never an error) and the newsletter subscribes people immediately without confirmation.
RESEND_API_KEY=
# A sender on a domain you verified in Resend, e.g. Frameflow <hello@your-domain.com>
EMAIL_FROM=
# Where copyright/content reports are emailed (your 48-hour takedown inbox)
ADMIN_EMAIL=
# Optional: a Resend Audience id. Confirmed newsletter subscribers are mirrored into it so you can
# send broadcasts from the Resend dashboard. Leave blank to skip. (Resend → Audiences)
RESEND_AUDIENCE_ID=
# Shown on the legal pages and Contact page
VITE_SUPPORT_EMAIL=support@your-domain.com

# ── Security ─────────────────────────────────────────────────────────────
# Random secret used to hash IPs for rate limits and free-search quotas, so raw IPs are never
# stored. Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Falls back to the service role key if unset, but set your own so rotating keys doesn't reset quotas.
RATE_LIMIT_SALT=

# ── Error tracking (Sentry, optional) ─────────────────────────────────────────
# Browser DSN (public). Leave blank to disable client error tracking.
VITE_SENTRY_DSN=
# Server DSN for the /api functions. Leave blank to disable server error tracking.
SENTRY_DSN=

# ── Analytics (optional) ─────────────────────────────────────
# none | plausible | posthog
VITE_ANALYTICS_PROVIDER=none
# Plausible: your site domain, e.g. frameflow.app
VITE_PLAUSIBLE_DOMAIN=
# PostHog: project API key and host (https://us.i.posthog.com or eu)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Seed script only ─────────────────────────────────────────
# Optional: a real user id (auth.users.id). Sample moodboards are created for it.
SEED_OWNER_ID=
