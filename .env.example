# ─────────────────────────────────────────────────────────────
# Frameflow environment variables. Copy to .env (local) and set the
# same names in Vercel → Project → Settings → Environment Variables.
# Variables starting with VITE_ are PUBLIC (shipped to the browser).
# Everything else is SERVER-ONLY and must never be prefixed with VITE_.
# The app runs in DEMO MODE (mock data, no login) if Supabase keys are missing.
# ─────────────────────────────────────────────────────────────

# ── Supabase (public) ────────────────────────────────────────
# Project URL: Supabase → Project Settings → API
VITE_SUPABASE_URL=
# The anon / publishable key (safe for the browser; protected by RLS)
VITE_SUPABASE_ANON_KEY=

# ── Supabase (server-only) ───────────────────────────────────
# Same project URL, used by /api functions and scripts
SUPABASE_URL=
# service_role key. BYPASSES RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site ─────────────────────────────────────────────────────
# Public site URL (no trailing slash). Used for sitemap and canonical/OG URLs.
VITE_SITE_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# ── Anthropic (server-only) — powers /api/find-references ────
ANTHROPIC_API_KEY=
# Model used for Find References
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Payments ─────────────────────────────────────────────────
# razorpay (default) or stripe (adapter stub, not implemented)
VITE_PAYMENT_PROVIDER=razorpay
# Razorpay Key Id (public, used by Checkout in the browser)
VITE_RAZORPAY_KEY_ID=
# Razorpay Key Id + Secret (server-only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret you set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=
# Plan ids; create them with `npm run razorpay:plans` or in the dashboard
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=
# Prices are no longer set here. Edit PRICING in src/lib/constants.ts (₹499/month, ₹3,999/year).
# The Razorpay plans above must match those amounts.

# ── Analytics (optional) ─────────────────────────────────────
# none | plausible | posthog
VITE_ANALYTICS_PROVIDER=none
# Plausible: your site domain, e.g. frameflow.app
VITE_PLAUSIBLE_DOMAIN=
# PostHog: project API key and host (https://us.i.posthog.com or eu)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Seed script only ─────────────────────────────────────────
# Optional: a real user id (auth.users.id). Sample moodboards are created for it.
SEED_OWNER_ID=
